<section id="Banner-{{ section.id }}" class="banner-container">
  <style>
    #Banner-{{ section.id }} .banner-container {
        width:1440px;
        height:878px;
        display:flex;
        flex-direction:column;
    }
    #Banner-{{ section.id }} .banner-top {
        width:100%
        height:64px;
        display:flex;
        padding: 0.625rem 3.125rem;
        justify-content:space-between;
        align-items:center;
    }
    #Banner-{{ section.id }} .banner-center {
        width:100%;
    }
    #Banner-{{ section.id }} .banner-bottom {
        width:100%;
        height:34px;
        display:flex;
        padding:padding: 0.625rem 3.125rem;
        justify-content:center;
        align-items:center;
    }

    #Banner-{{ section.id }} .banner-center img{
        width:100%;
        object-fit:cover;
    }
  </style>

  <div class="banner-top">
    {% if section.settings.title != blank %}
      <div><span>{{ section.settings.title | escape }}</span></div>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <div><span>{{ section.settings.subtitle | escape }}</span></div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <div>
        <a class="button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>

  <div class="banner-center">
    {% if section.settings.image %}
        <img
          src="{{ section.settings.image | image_url }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy">
    {% endif %}
  </div>

  <div class="banner-bottom">
    {% if section.settings.bottom_text != blank %}
      <span>{{ section.settings.bottom_text | escape }}</span>
    {% endif %}
  </div>

  {% schema %}
  {
    "name": "Banner",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "TISSO VISION"
      },
      {
        "type": "text",
        "id": "subtitle",
        "label": "Subtitle",
        "default": "Find the ideal gift for your loved ones"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Banner image"
      },
      {
        "type": "text",
        "id": "bottom_text",
        "label": "Bottom text",
        "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "CHOOSE GIFT"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }
    ],
    "presets": [
      {
        "name": "Banner"
      }
    ]
  }
  {% endschema %}
</section>