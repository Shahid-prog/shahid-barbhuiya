<section id="Banner-{{ section.id }}" class="banner-container">
  <style>
    #Banner-{{ section.id }} .banner-container {
        width:1440px;
        height:878px;
        display:flex;
        flex-direction:column;
    }
    #Banner-{{ section.id }} .banner-top {
        width:100%;
        height:64px;
        display:flex;
        padding: 10px 50px;
        justify-content:space-between;
        align-items:center;
        background-color: #F5F5F5;
    }
    #Banner-{{ section.id }} .banner-center {
        width:100%;
    }
    #Banner-{{ section.id }} .banner-bottom {
        width:100%;
        height:34px;
        display:flex;
        padding:10px 50px;
        justify-content:center;
        align-items:center;
        background-color: #F5F5F5;
    }

    #Banner-{{ section.id }} .banner-center img{
        width:100%;
        object-fit:cover;
    }

    #Banner-{{ section.id }} .banner-top .banner-top-text{
        font-family: "Jost", sans-serif;
        font-weight: 400;
        font-style: normal;
        font-size: 16px;
        line-height: 13.42px;
        letter-spacing: 0px;
    }
    #Banner-{{ section.id }} .banner-bottom .banner-bottom-text{
        font-family: "Jost", sans-serif;
        font-weight: 400;
        font-style: normal;
        font-size: 16px;
        line-height: 13.42px;
        letter-spacing: 0px;
    }
  </style>

  <div class="banner-top">
    {% if section.settings.logo %}
        <img
          src="{{ section.settings.logo | image_url }}"
          alt="{{ section.settings.logo.alt | escape }}"
          loading="lazy">
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <div><span class="banner-top-text">{{ section.settings.subtitle | escape }}</span></div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <div>
        <a class="button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>

  <div class="banner-center">
    {% if section.settings.image %}
        <img
          src="{{ section.settings.image | image_url }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy">
    {% endif %}
  </div>

  <div class="banner-bottom">
    {% if section.settings.bottom_text != blank %}
      <span class="banner-bottom-text">{{ section.settings.bottom_text | escape }}</span>
    {% endif %}
  </div>

  {% schema %}
  {
    "name": "Banner",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "text",
        "id": "subtitle",
        "label": "Subtitle",
        "default": "Find the ideal gift for your loved ones"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Banner image"
      },
      {
        "type": "text",
        "id": "bottom_text",
        "label": "Bottom text",
        "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "CHOOSE GIFT"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }
    ],
    "presets": [
      {
        "name": "Banner"
      }
    ]
  }
  {% endschema %}
</section>