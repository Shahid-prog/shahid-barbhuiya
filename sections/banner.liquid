<section id="Banner-{{ section.id }}" class="banner-container">
  <style>
    #Banner-{{ section.id }} .banner-container {
        width:1440px;
        height:878px;
        display:flex;
        flex-direction:column;
    }
    #Banner-{{ section.id }} .banner-top {
        width:100%;
        height:64px;
        display:flex;
        padding: 10px 50px;
        justify-content:space-between;
        align-items:center;
        background-color: #F5F5F5;
    }
    #Banner-{{ section.id }} .banner-center {
        width:100%;
        min-height:780px;
        position:relative;
        background-image:url({% if section.settings.image %}{{ section.settings.image | image_url }}{% endif %});
    }
    #Banner-{{ section.id }} .banner-bottom {
        width:100%;
        height:34px;
        display:flex;
        padding:10px 50px;
        justify-content:center;
        align-items:center;
        background-color: #F5F5F5;
    }

    #Banner-{{ section.id }} .banner-center img{
        width:100%;
        object-fit:cover;
    }

    #Banner-{{ section.id }} .banner-top .banner-top-text{
        font-family: "Jost", sans-serif;
        font-weight: 400;
        font-style: normal;
        font-size: 16px;
        line-height: 13.42px;
        letter-spacing: 0px;
    }
    #Banner-{{ section.id }} .banner-bottom .banner-bottom-text{
        font-family: "Jost", sans-serif;
        font-weight: 400;
        font-style: normal;
        font-size: 16px;
        line-height: 13.42px;
        letter-spacing: 0px;
    }
    #Banner-{{ section.id }} .banner-top .button{
        width: 207px;
        height: 44px;
        opacity: 1;
        background: #FFF544;
        --border-opacity:none;
    }
    #Banner-{{ section.id }} .banner-top .button .label{
        color: #000000;
        font-family: "Jost";
        font-weight: 400;
        font-style: normal;
        font-size: 16px;
        line-height: 20.48px;
        letter-spacing: 0px;
        text-transform: uppercase;
        margin-right:18px;
    }
    #Banner-{{ section.id }} .banner-top .logo{
        width: 151.44406127929688px;
        height: 19px;
        opacity: 1;
    }
    #Banner-{{ section.id }} .banner-center .banner-info{
      position:absolute;
      top: 425px;
      left: 67px;
      display:flex;
      flex-direction:column;
      align-items:space-between;
    }
    #Banner-{{ section.id }} .banner-center .banner-info .description{
        width: 483px;
        height: 84px;
        color:#000000;
        font-family: "Jost";
        font-weight: 400;
        font-style: normal;
        font-size: 20px;
        line-height: 140%;
        letter-spacing: 0px;
    }
    #Banner-{{ section.id }} .banner-center .banner-info .title{
        width: 459px;
        height: 70px;
        color:#000000;
        font-family: "Jost";
        font-weight: 500;
        font-size: 70px;
        line-height: 100%;
        letter-spacing: 0px;
    }
  </style>

  <div class="banner-top">
    {% if section.settings.logo %}
        <img
          class="logo"
          src="{{ section.settings.logo | image_url }}"
          alt="{{ section.settings.logo.alt | escape }}"
          loading="lazy">
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <div><span class="banner-top-text">{{ section.settings.subtitle | escape }}</span></div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <div>
        <a class="button" href="{{ section.settings.button_link }}">
          <span class="label">{{ section.settings.button_label | escape }}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="12" viewBox="0 0 26 12" fill="none">
            <path d="M1.22205 4.80469L0.472046 4.80469L0.472046 6.30469L1.22205 6.30469L1.22205 4.80469ZM25.7524 6.08502C26.0453 5.79213 26.0453 5.31725 25.7524 5.02436L20.9794 0.251388C20.6865 -0.0415053 20.2116 -0.0415053 19.9187 0.251388C19.6259 0.544281 19.6259 1.01916 19.9187 1.31205L24.1614 5.55469L19.9187 9.79733C19.6259 10.0902 19.6259 10.5651 19.9187 10.858C20.2116 11.1509 20.6865 11.1509 20.9794 10.858L25.7524 6.08502ZM1.22205 6.30469L25.222 6.30469L25.222 4.80469L1.22205 4.80469L1.22205 6.30469Z" fill="black"/>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>

  <div class="banner-center">
    <div class="banner-info">
      <div class="title">The Gift Guide</div>
      <div class="description">Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</div>
      <div>
        <a class="button" href="">
          <span class="label">Shop Now</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="12" viewBox="0 0 26 12" fill="none">
            <path d="M1.22205 4.80469L0.472046 4.80469L0.472046 6.30469L1.22205 6.30469L1.22205 4.80469ZM25.7524 6.08502C26.0453 5.79213 26.0453 5.31725 25.7524 5.02436L20.9794 0.251388C20.6865 -0.0415053 20.2116 -0.0415053 19.9187 0.251388C19.6259 0.544281 19.6259 1.01916 19.9187 1.31205L24.1614 5.55469L19.9187 9.79733C19.6259 10.0902 19.6259 10.5651 19.9187 10.858C20.2116 11.1509 20.6865 11.1509 20.9794 10.858L25.7524 6.08502ZM1.22205 6.30469L25.222 6.30469L25.222 4.80469L1.22205 4.80469L1.22205 6.30469Z" fill="black"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="banner-bottom">
    {% if section.settings.bottom_text != blank %}
      <span class="banner-bottom-text">{{ section.settings.bottom_text | escape }}</span>
    {% endif %}
  </div>

  {% schema %}
  {
    "name": "Banner",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "text",
        "id": "subtitle",
        "label": "Subtitle",
        "default": "Find the ideal gift for your loved ones"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Banner image"
      },
      {
        "type": "text",
        "id": "bottom_text",
        "label": "Bottom text",
        "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "CHOOSE GIFT"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }
    ],
    "presets": [
      {
        "name": "Banner"
      }
    ]
  }
  {% endschema %}
</section>