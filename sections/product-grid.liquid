<section id="Grid-{{ section.id }}" class="product-grid-section">
  <style>
    #Grid-{{ section.id }} .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    #Grid-{{ section.id }} .grid-item a {
      display: block;
      text-decoration: none;
      color: inherit;
    }
    #Grid-{{ section.id }} .card-media {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: #f6f6f6;
    }
    #Grid-{{ section.id }} .card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    #Grid-{{ section.id }} .card-info {
      margin-top: 10px;
      display: grid;
      gap: 6px;
    }
    #Grid-{{ section.id }} .card-title {
      margin: 0;
      font-size: 16px;
      line-height: 1.4;
    }
    #Grid-{{ section.id }} .card-price {
      display: flex;
      gap: 8px;
      align-items: baseline;
      font-size: 14px;
    }
    #Grid-{{ section.id }} .price--sale {
      color: #d12727;
      font-weight: 600;
    }
    #Grid-{{ section.id }} .price--compare {
      text-decoration: line-through;
      opacity: 0.7;
    }
    /* Optional: simple responsive tweak */
    @media (max-width: 990px) {
      #Grid-{{ section.id }} .grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 600px) {
      #Grid-{{ section.id }} .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product -%}
        <div class="grid-item" {{ block.shopify_attributes }}>
          <a href="{{ product.url }}">
            <div class="card-media">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="card-info">
              <h3 class="card-title">{{ product.title }}</h3>
              <div class="card-price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="price price--sale">{{ product.price | money }}</span>
                  <span class="price price--compare">{{ product.compare_at_price | money }}</span>
                {%- else -%}
                  <span class="price">{{ product.price | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {% schema %}
{
  "name": "Product grid",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Product grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
</section>