<section id="Grid-{{ section.id }}" class="product-grid-section">
  <style>
    #Grid-{{ section.id }} .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    #Grid-{{ section.id }} .grid-item{
        width: 433px;
        height: 444px;
    }
    #Grid-{{ section.id }} .grid-item a {
      display: block;
      text-decoration: none;
      color: inherit;
    }
    #Grid-{{ section.id }} .card-media {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: #f6f6f6;
    }
    #Grid-{{ section.id }} .card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    /* Optional: simple responsive tweak */
    @media (max-width: 990px) {
      #Grid-{{ section.id }} .grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 600px) {
      #Grid-{{ section.id }} .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product -%}
        <div class="grid-item" {{ block.shopify_attributes }}>
          <a href="{{ product.url }}">
            <div class="card-media">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {% schema %}
{
  "name": "Product grid",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Product grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
</section>