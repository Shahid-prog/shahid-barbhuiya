<section id="Grid-{{ section.id }}" class="product-grid-section">
  <style>
     #Grid-{{ section.id }}{
        width:1440px;
        height:878px;
        padding-top:90px;
        padding-left:51.5px;
        padding-right:51.5px;
        padding-bottom:51px;
     }
     #Grid-{{ section.id }} .grid {
        width: 1339px;
        height: 908px;
        display: grid;
        grid-template-columns: repeat(3, 433px);
        gap: 20px;
    }
    #Grid-{{ section.id }} .grid-item {
        width: 433px;
        height: 444px;
    }
    #Grid-{{ section.id }} .card-media {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #f6f6f6;
    }
    #Grid-{{ section.id }} .card-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    #Grid-{{ section.id }} .title {
        font-family: "Lustria",serif;
        font-weight: 400;
        font-style: normal;
        font-size: 36px;
        line-height: 120%;
        letter-spacing: 0px;
    }
  </style>
  <div class="title"><span>Tisso vison in the wild</span></div>
  <div class="grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product -%}
        <div class="grid-item">
          <a href="{{ product.url }}">
            <div class="card-media">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {% schema %}
{
  "name": "Product grid",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Product grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
</section>