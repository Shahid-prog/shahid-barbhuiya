<section id="Grid-{{ section.id }}" class="product-grid-section">
  <style>
     #Grid-{{ section.id }} .grid {
      display: grid;
      grid-template-columns: repeat(3, 433px);
      gap: 20px;
    }
    #Grid-{{ section.id }} .grid-item {
      width: 433px;
      height: 444px;
    }
    #Grid-{{ section.id }} .card-media {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #f6f6f6;
    }
    #Grid-{{ section.id }} .card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  </style>

  <div class="grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product -%}
        <div class="grid-item">
          <a href="{{ product.url }}">
            <div class="card-media">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {% schema %}
{
  "name": "Product grid",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Product grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
</section>